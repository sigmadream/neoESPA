# neoESPA 환경 변수 예시
#
# 이 파일을 `.env`로 복사한 뒤 값을 채워 사용합니다.
#   cp env_example .env
#
# 주석 처리된 항목은 코드에 기본값이 있어 지정하지 않아도 동작합니다.
# 각 항목의 실제 사용처는 backend/app/core/config.py 를 참조하시기 바랍니다.

# --- 애플리케이션 ---
APP_VERSION="3.0.0"
# 실행 환경. development / test / production 을 인식합니다.
APP_ENV="development"

# --- 데이터베이스 ---
# SQLAlchemy 연결 URL. 지정하지 않으면 저장소 내 SQLite 파일을 사용합니다.
# 현재 마이그레이션은 SQLite에서만 검증합니다.
DATABASE_URL="sqlite:////database/database.sqlite"
# SQL 쿼리 로그 출력 여부 (기본: false)
# SQL_ECHO="false"

# --- 보안 ---
# 32바이트 이상의 값으로 반드시 교체해야 합니다.
JWT_SECRET="your-secret-key-here-must-be-32-bytes"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- 채점 및 샌드박스 ---
AUTO_GRADING_ENABLED="true"
SANDBOX_READY="false"
INTERACTIVE_JUDGING_ENABLED="false"
JUDGE_RUNTIME_VERSION="development-host-v1"
# SANDBOX_READY=true 인 경우, 아래 attestation 파일의 runtime_version이
# JUDGE_RUNTIME_VERSION과 일치해야 샌드박스가 준비된 것으로 판정합니다.
SANDBOX_ATTESTATION_PATH="/var/lib/neoespa-sandbox/attestation.json"
NSJAIL_CONFIG_PATH="/etc/neoespa/nsjail.cfg"

# --- 코스 ---
COURSE_BUNDLE_ROOT="/data/neoespa/dev/course"
COURSE_ID="CS101"
COURSE_TERM="2026-fall"

# --- 분석 데이터 내보내기 ---
# export-analytics-jsonl CLI 실행에 필요합니다.
ANALYTICS_HMAC_SECRET="replace-with-school-managed-secret-at-least-32-bytes"

# --- 코드 스냅샷 rate limit ---
# 지정한 시간(초) 동안 허용할 스냅샷 저장 횟수 (기본: 20회 / 60초)
# SNAPSHOT_RATE_LIMIT_COUNT="20"
# SNAPSHOT_RATE_LIMIT_WINDOW_SECONDS="60"

# --- 기타 ---
# supportFiles 디렉터리 위치. 지정하지 않으면 상위 경로를 탐색해 자동으로 찾습니다.
# NEOESPA_SUPPORT_DIR="/path/to/supportFiles"
