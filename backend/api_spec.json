{
  "name": "neoespa_api",
  "description": "neoESPA 학습 관리 시스템의 백엔드 API 서비스",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "get_homework_list",
      "path": "/api/homework",
      "method": "GET",
      "description": "학생이 제출 가능한 과제 목록을 조회합니다.",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "default": 100 },
          "offset": { "type": "integer", "default": 0 }
        }
      }
    },
    {
      "id": "submit_homework",
      "path": "/api/submissions",
      "method": "POST",
      "description": "특정 과제에 대한 소스 코드를 제출합니다.",
      "parameters": {
        "type": "object",
        "properties": {
          "homework_num": { "type": "integer" },
          "language": { "type": "string", "enum": ["python", "c", "cpp", "java"] },
          "code_text": { "type": "string" },
          "original_filename": { "type": "string" }
        },
        "required": ["homework_num", "language", "code_text"]
      }
    },
    {
      "id": "get_submission_feedback",
      "path": "/api/submissions/{id}/feedback",
      "method": "GET",
      "description": "제출한 과제 결과에 대한 인공지능 피드백과 힌트를 조회합니다.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "제출 ID" }
        },
        "required": ["id"]
      }
    },
    {
      "id": "get_student_dashboard",
      "path": "/api/dashboard/me",
      "method": "GET",
      "description": "현재 로그인한 학생의 학습 요약 데이터를 조회합니다."
    },
    {
      "id": "get_notifications",
      "path": "/api/notifications",
      "method": "GET",
      "description": "사용자의 읽지 않은 알림 목록을 조회합니다."
    },
    {
      "id": "get_notice_list",
      "path": "/api/notice",
      "method": "GET",
      "description": "시스템 전체 공지사항 목록을 조회합니다."
    },
    {
      "id": "admin_get_dashboard",
      "path": "/api/admin/dashboard",
      "method": "GET",
      "description": "관리자 전용 시스템 전체 통계 데이터를 조회합니다."
    },
    {
      "id": "admin_import_homework",
      "path": "/api/admin/homeworks/import",
      "method": "POST",
      "description": "ZIP 파일을 통해 과제 및 테스트케이스를 일괄 임포트합니다.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "codeName": { "type": "string" },
          "isLint": { "type": "boolean" }
        },
        "required": ["title", "codeName", "isLint"]
      }
    },
    {
      "id": "admin_run_plagiarism",
      "path": "/api/admin/homeworks/{num}/plagiarism/run",
      "method": "POST",
      "description": "특정 과제에 대해 제출물 간 표절 검사를 실행합니다.",
      "parameters": {
        "type": "object",
        "properties": {
          "num": { "type": "integer", "description": "과제 번호" }
        },
        "required": ["num"]
      }
    }
  ]
}
